# Static analysis of the plugin, run inside a Pelican panel in CI (checks.yml, panel-smoke): the panel's vendor folder
# holds Laravel, Filament and Pelican's own classes. Level 5: wrong types, unknown methods and properties, dead code.
includes:
    - ../../vendor/larastan/larastan/extension.neon
parameters:
    level: 5
    paths:
        - src
        - database
    excludePaths:
        - tests
    tmpDir: ../../storage/framework/cache/phpstan
    reportUnmatchedIgnoredErrors: false
    ignoreErrors:
        # A guard for another version of the core or of Pelican (ADDONS.md: a newer add-on keeps working on an older
        # core) is always true or false against the one version CI installs.
        - '#(method|class|function|property)_exists\(\) with .* will always evaluate to (true|false)#'
